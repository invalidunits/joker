[sub_resource type="GDScript" id="GDScript_7jktm"]
script/source = "extends AnimationPlayer


var looking_at_table:bool
var last_animation:String

func _process(delta: float) -> void:
	var current_anim_pos = 0.0
	if is_playing():
		current_anim_pos = current_animation_position
	else:
		current_anim_pos = 1.0 if last_animation == \"LookAtTableF\" else 0.0
		
	if looking_at_table and (not is_playing() or current_anim_pos < 1.0):
		if not is_equal_approx(current_anim_pos, 1.0):
			play_section(&\"LookAtTable\", current_anim_pos, 1.0, -1, 1.0, false)
	elif not looking_at_table and last_animation == &\"LookAtTableF\":
		if not is_equal_approx(current_anim_pos, 0.0):
			play_section_backwards(&\"LookAtTable\", 0.0, current_anim_pos)
	
	if is_playing():
		last_animation = current_animation
		if get_playing_speed() < 0:
			last_animation += \"B\"
		else:
			last_animation += \"F\"
"

