[sub_resource type="GDScript" id="GDScript_fc0e3"]
script/source = "extends Control



@onready var animation_player: AnimationPlayer = $\"../../Node3D/AnimationPlayer\"


func _process(delta: float) -> void:
	var mouse := get_global_mouse_position();
	var looking_at_table = get_rect().has_point(mouse);
	animation_player.looking_at_table = looking_at_table
"

