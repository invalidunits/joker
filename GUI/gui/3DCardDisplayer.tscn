[sub_resource type="GDScript" id="GDScript_84q04"]
script/source = "@tool
extends SpriteMeshInstance

@export var card: Card

func _render():
	if is_instance_valid(card):
		set_frame(card._get_card_spr_index())

func _process(delta: float):
	super(delta)
	_render()
"

