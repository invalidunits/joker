[sub_resource type="GDScript" id="GDScript_8e51s"]
script/source = "@tool
extends Node

const OnlineMatchSession = preload(\"res://Scenes/online_match_session.gd\")

@export_file(\"*.tscn\") var online_scene_path: String = \"res://Scenes/Online.tscn\"
var _auto_join_started := false


@export var selected_menu:int = 0:
	set(x):
		selected_menu = clampi(x, 0, get_child_count() - 1)
func _ready() -> void:
	if not Engine.is_editor_hint():
		OnlineMatchSession.apply_runtime_overrides()
		if OnlineMatchSession.has_match() and ResourceLoader.exists(online_scene_path) and not _auto_join_started:
			_auto_join_started = true
			call_deferred(\"_open_online_scene\")
			return
		selected_menu = 0

func _open_online_scene() -> void:
	if get_tree() != null:
		get_tree().change_scene_to_file(online_scene_path)

func _process(_delta: float) -> void:
	for i in range(get_child_count()):
		get_child(i).visible = i == selected_menu
		get_child(i).process_mode = Node.PROCESS_MODE_INHERIT if i == selected_menu else Node.PROCESS_MODE_DISABLED 

func _on_play_button_pressed() -> void:
	selected_menu = 1

func _on_quit_button_pressed() -> void:
	get_tree().quit(0)

func _on_stop_waiting_pressed() -> void:
	selected_menu = 0
"

[sub_resource type="GDScript" id="GDScript_yk3ul"]
script/source = "extends CanvasLayer


const OnlineMatchSession = preload(\"res://Scenes/online_match_session.gd\")


@export var backend_base_url: String = \"http://127.0.0.1:8080\"
@export_file(\"*.tscn\") var online_scene_path: String = \"res://Scenes/Online.tscn\"

var _wait_time := 0.0
var _http_request: HTTPRequest

@export var waiting_for_time: Label 
@onready var status_label: Label = $VBoxContainer/HSplitContainer2/StatusLabel
@onready var dots_animation_player: AnimationPlayer = $VBoxContainer/HSplitContainer2/Dots/DotsAnimationPlayer
var _working: bool = false
@onready var waiting: HSplitContainer = $VBoxContainer/Waiting


func _ready() -> void:
	OnlineMatchSession.apply_runtime_overrides(backend_base_url)
	if not OnlineMatchSession.backend_base_url.is_empty():
		backend_base_url = OnlineMatchSession.backend_base_url


func _on_visibility_changed() -> void:
	if visible:
		waiting.visible = true
		_working = true
		_wait_time = 0.0
		_connect_to_queue()
	else:
		_cancel_request()


func _process(delta: float) -> void:
	if not visible:
		return
	if _working:
		_wait_time += delta
		waiting_for_time.text = str(roundi(_wait_time)) + \"s\"
		dots_animation_player.play(\"Anim\")
	else:
		dots_animation_player.play(\"RESET\")

func _failed_connection(reason: String) -> void:
	push_warning(\"Failed to connect (error %s)\" % reason)
	status_label.text = reason
	_working = false
	waiting.visible = false


func _connect_to_queue() -> void:
	_cancel_request()
	status_label.text = \"Reaching Matchmaking Server\"

	_http_request = HTTPRequest.new()
	add_child(_http_request)
	_http_request.request_completed.connect(_on_request_completed)

	var url := backend_base_url.trim_suffix(\"/\") + \"/match\"
	var err := _http_request.request(url)
	if err != OK:
		_cancel_request()
		_failed_connection(\"Failed to send request\")
	else:
		status_label.text = \"Waiting for Opponent\"


func _on_request_completed(result: int, response_code: int, _headers: PackedStringArray, body: PackedByteArray) -> void:
	_cancel_request()
	if result != HTTPRequest.RESULT_SUCCESS:
		_failed_connection(\"Connection Failed\")
		return
	if response_code != 200:
		_failed_connection(\"Server error: %d\" % response_code)
		return
	_handle_queue_payload(body.get_string_from_utf8())


func _handle_queue_payload(payload: String) -> void:
	var json := JSON.new()
	if json.parse(payload) != OK:
		push_warning(\"Invalid matchmaking payload: %s\" % payload)
		_failed_connection(\"Invalid server response\")
		return

	if typeof(json.data) != TYPE_DICTIONARY:
		_failed_connection(\"Invalid server response\")
		return

	var message: Dictionary = json.data
	print(message)
	var match_id := str(message.get(\"id\", \"\"))
	if match_id.is_empty():
		_failed_connection(\"Missing match ID\")
		return

	_working = false
	status_label.text = \"Match found! Joining game\"
	OnlineMatchSession.store_match(backend_base_url, match_id)
	if ResourceLoader.exists(online_scene_path):
		get_tree().change_scene_to_file(online_scene_path)
	else:
		push_warning(\"Online scene missing at %s\" % online_scene_path)


func _cancel_request() -> void:
	if _http_request != null:
		_http_request.cancel_request()
		_http_request.queue_free()
		_http_request = null
"

